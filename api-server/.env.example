# Redis pub/sub used for streaming live transcoding logs.
# In docker-compose this resolves to the `redis` service.
REDIS_URL=redis://redis:6379

# S3 bucket the transcoder uploads HLS segments to. Must be world-readable
# (or behind a CDN) for the browser player to fetch the .m3u8 + .ts segments.
AWS_REGION=ap-south-1
S3_BUCKET=your-hls-bucket

# AWS credentials passed through to the transcoder container. Use an IAM
# user scoped to PutObject on the bucket above.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Image tag the API server spawns per transcoding job via `docker run`.
# Build it locally with `docker build -t transcoder ./transcoder`.
TRANSCODER_IMAGE=transcoder

# Network the spawned transcoder container joins. Set this to the
# docker-compose project network (e.g. hls-transcoder_hls) so the
# transcoder can publish logs back to the redis service by name.
TRANSCODER_NETWORK=
