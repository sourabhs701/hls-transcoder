# These are usually injected by the api-server when it spawns this
# container per transcoding job. Set them here only when running the
# transcoder standalone (e.g. `node src/index.js`) for development.

# Source video on S3 (must be readable by the IAM user below).
S3__URL=
PROJECT_ID=

# Redis pub/sub channel for live ffmpeg log streaming.
REDIS_URL=redis://redis:6379

# Output bucket. The transcoder writes .m3u8 + .ts segments under
# __outputs/{PROJECT_ID}/.
AWS_REGION=ap-south-1
S3_BUCKET=your-hls-bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
